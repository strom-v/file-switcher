{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Канонический контракт правила подмены (src/shared/types.ts, rulesStore, прокси в src/main/proxy). Тест src/shared/ruleSchema.test.ts падает, если типы разошлись со схемой.",
  "title": "Rule",
  "type": "object",
  "required": ["id", "enabled", "urlPattern", "isRegex"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "enabled": { "type": "boolean" },
    "urlPattern": { "type": "string" },
    "isRegex": { "type": "boolean" },
    "group": { "type": "string" },
    "localFilePath": { "type": "string" },
    "responseBody": { "type": "string" },
    "contentType": { "type": "string" },
    "requestHeaderOverrides": { "type": "array", "items": { "$ref": "#/definitions/headerOverride" } },
    "responseHeaderOverrides": { "type": "array", "items": { "$ref": "#/definitions/headerOverride" } },
    "delayMs": { "type": "number", "minimum": 0, "maximum": 60000 },
    "statusCodeOverride": { "type": "integer", "minimum": 100, "maximum": 599 }
  },
  "definitions": {
    "headerOverride": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}
